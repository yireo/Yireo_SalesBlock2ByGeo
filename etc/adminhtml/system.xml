<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="salesblock" translate="label" sortOrder="342" showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="settings">
                <field id="geoip_country_database" type="text" translate="label comment" sortOrder="3" showInDefault="1"
                       showInWebsite="0" showInStore="0">
                    <label>GeoIP v2 country database file</label>
                    <backend_model>Yireo\SalesBlock2ByGeo\Model\Config\Backend\GeoIpDatabase</backend_model>
                    <comment>Path of a MaxMind *.mmdb file, relative to the var/ folder (for instance geoip/GeoLite2-Country.mmdb). Preferred over GeoIP v1.</comment>
                </field>
                <field id="trusted_proxies" type="textarea" translate="label comment" sortOrder="4" showInDefault="1"
                       showInWebsite="0" showInStore="0">
                    <label>Trusted proxies</label>
                    <comment>IP addresses of your reverse proxies (load balancer, CDN, Varnish), separated by commas or new lines. The X-Forwarded-For header is only used when a request comes from one of these IPs. Leave empty when Magento is not behind a proxy.</comment>
                </field>
                <field id="geoip" translate="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>GeoIP support</label>
                    <frontend_model>Yireo\SalesBlock2ByGeo\Block\Adminhtml\System\Config\Check</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
